# Ignorer tout
*
gradlew

# Sauf les fichiers Java
!*.java

# Sauf aussi les sous-répertoires (sinon !*.java ne suffira pas)
!*/

# Sauf le fichier des règles de grammairs
!grammarRules.txt

# Sauf les Todos
!ToDo.txt

# sauf les codes de test
!code_test.txt

# sauf les ressources des tests
!./test/resources/*

#sauf les txt de façon générales
!*.txt

# (Optionnel) ignorer les fichiers compilés
*.class


# (Optionnel) ignorer les fichiers système
.DS_Store
Thumbs.db

# Gradle
.gradle/
build/

# IntelliJ
.idea/

# Tests / outputs temporaires
*.log
*.tmp
